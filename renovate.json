{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "reference/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CROWDSEC_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "CROWDSEC_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "crowdsecurity/crowdsec"
    },
    {
      "customType": "regex",
      "description": "POSTGRES_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "POSTGRES_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "postgres"
    },
    {
      "customType": "regex",
      "description": "SOCKET_PROXY_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "SOCKET_PROXY_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "tecnativa/docker-socket-proxy"
    },
    {
      "customType": "regex",
      "description": "WHOAMI_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "WHOAMI_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "traefik/whoami"
    },
    {
      "customType": "regex",
      "description": "CURL_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "CURL_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "curlimages/curl"
    }
  ],
  "packageRules": [
    {
      "description": "npmos/ is the NPMplus subtree: its dependencies come with git subtree pull, not from Renovate",
      "matchFileNames": [
        "npmos/**"
      ],
      "enabled": false
    },
    {
      "description": "except CrowdSec of the offline hub seed in npmos/Dockerfile: it must move together with deploy/.env (checked in CI)",
      "matchFileNames": [
        "npmos/Dockerfile"
      ],
      "matchDepNames": [
        "docker.io/crowdsecurity/crowdsec",
        "crowdsecurity/crowdsec"
      ],
      "enabled": true
    },
    {
      "description": "CrowdSec is pinned in deploy/.env, npmos/Dockerfile and deploy/dev/Dockerfile (CI checks they match): one PR for all three",
      "matchDepNames": [
        "crowdsecurity/crowdsec",
        "docker.io/crowdsecurity/crowdsec"
      ],
      "groupName": "crowdsec"
    },
    {
      "description": "Alpine of the open-appsec agent build is pinned: CMake 4 (Alpine 3.23+) rejects the pinned sources; bump by hand with OPENAPPSEC_REF",
      "matchFileNames": [
        "deploy/openappsec/agent/Dockerfile"
      ],
      "matchDepNames": [
        "docker.io/library/alpine"
      ],
      "enabled": false
    }
  ]
}
