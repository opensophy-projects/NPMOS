{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CROWDSEC_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "CROWDSEC_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "crowdsecurity/crowdsec"
    },
    {
      "customType": "regex",
      "description": "POSTGRES_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "POSTGRES_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "postgres"
    },
    {
      "customType": "regex",
      "description": "WHOAMI_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "WHOAMI_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "traefik/whoami"
    },
    {
      "customType": "regex",
      "description": "CURL_VERSION in deploy/.env",
      "managerFilePatterns": [
        "/^deploy/\\.env$/"
      ],
      "matchStrings": [
        "CURL_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "curlimages/curl"
    },
    {
      "customType": "regex",
      "description": "images of the security tools in .github/security/tools.env (version and digest)",
      "managerFilePatterns": [
        "/^\\.github/security/tools\\.env$/"
      ],
      "matchStrings": [
        "[A-Z_]+_IMAGE=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "nginxions/ is the NPMplus subtree: its dependencies come with git subtree pull, not from Renovate",
      "matchFileNames": [
        "nginxions/**"
      ],
      "enabled": false
    },
    {
      "description": "except CrowdSec of the offline hub seed in nginxions/Dockerfile: it must move together with deploy/.env (checked in CI)",
      "matchFileNames": [
        "nginxions/Dockerfile"
      ],
      "matchDepNames": [
        "docker.io/crowdsecurity/crowdsec",
        "crowdsecurity/crowdsec"
      ],
      "enabled": true
    },
    {
      "description": "CrowdSec is pinned in deploy/.env, nginxions/Dockerfile and deploy/dev/Dockerfile (CI checks they match): one PR for all three",
      "matchDepNames": [
        "crowdsecurity/crowdsec",
        "docker.io/crowdsecurity/crowdsec"
      ],
      "groupName": "crowdsec"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "openappsec/**"
  ]
}
