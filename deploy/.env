# NPMOS stack versions and registry. Read automatically by `docker compose -f deploy/compose.yaml`.
# Pinned on purpose: versions are bumped by hand in a commit, never as a silent `latest`.
# Any value can be overridden from the shell environment.

# Images built by the NPMOS project: npmos, npmos-appsec-{agent,smartsync,shared-storage,tuning}
NPMOS_REGISTRY=docker.io/opensophy
NPMOS_VERSION=develop

# Official upstream images
# CROWDSEC_VERSION must match ARG CROWDSEC_VERSION in npmos/Dockerfile (offline hub seed; checked in CI)
CROWDSEC_VERSION=v1.8.1
POSTGRES_VERSION=18.6-alpine
SOCKET_PROXY_VERSION=v0.5.0

# Test-only images (compose.dev.yaml, test/compose.airgap.yaml)
WHOAMI_VERSION=v1.11.0
CURL_VERSION=8.17.0
