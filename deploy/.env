# NginxionS stack versions and registry. Read automatically by `docker compose -f deploy/compose.yaml`.
# Pinned on purpose: updates come as pull requests (Renovate), never as a silent `latest`.
# Any value can be overridden from the shell environment.

# Images built by the NginxionS project: nginxions, nginxions-openappsec (the agent, its learning services, nginxions-control)
NGINXIONS_REGISTRY=docker.io/opensophy
NGINXIONS_VERSION=develop

# Official upstream images
# CROWDSEC_VERSION must match ARG CROWDSEC_VERSION in nginxions/Dockerfile (offline hub seed; checked in CI)
CROWDSEC_VERSION=v1.8.2
POSTGRES_VERSION=18.7-alpine

# Test-only images (compose.dev.yaml, test/compose.airgap.yaml)
WHOAMI_VERSION=v1.12.0
CURL_VERSION=8.23.0
